DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# where this app is reachable
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# the root domain, minus protocol and port - middleware splits hostnames against it
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# leave empty in development: browsers reject a Domain attribute on localhost
COOKIE_DOMAIN=